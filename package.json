{
  "name": "grimoire-companion",
  "displayName": "Grimoire Companion",
  "version": "0.2.0",
  "description": "Save pages to your local Grimoire library.",
  "author": "Robert Goniszewski <robert@goniszewski.com>",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "package": "wxt zip",
    "package:firefox": "wxt zip -b firefox",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@wxt-dev/module-react": "1.1.3",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wxt": "^0.21.4"
  }
}
